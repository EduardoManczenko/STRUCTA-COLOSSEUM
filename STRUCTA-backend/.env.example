# ====== Supabase ======
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<sua-anon-key>
# Obtenha em: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=<sua-service-role-key>

# ====== JWT para sessoes de wallet ======
JWT_SECRET=<minimo-32-caracteres-aleatorios>
JWT_ISSUER=structa-api
JWT_AUDIENCE=structa-frontend
JWT_EXPIRES_IN=7d

# ====== App ======
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ====== Chainalysis (mocked em dev) ======
CHAINALYSIS_API_KEY=<sua-chainalysis-api-key>
CHAINALYSIS_API_URL=https://public.chainalysis.com/api/v1

# ====== Solana ======
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
USDC_MINT_ADDRESS=<endereco-do-mint-usdc>
