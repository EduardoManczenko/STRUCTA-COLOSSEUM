{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "downlevelIteration": true,
    "lib": ["es2022", "dom"]
  },
  "include": ["sdk/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
